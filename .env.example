# =====================================================================
# .env.example — Plantilla de referencia.
# -----------------------------------------------------------------------
# Este proyecto es un sitio estático (GitHub Pages), así que NO lee
# variables de entorno en tiempo de ejecución. Sirve como documentación
# de qué valores necesitas y dónde van realmente:
#
#   SUPABASE_URL           -> pégalo en assets/js/config.js (SUPABASE_URL)
#   SUPABASE_ANON_KEY       -> pégalo en assets/js/config.js (SUPABASE_ANON_KEY)
#
# La anon key es segura de exponer en el frontend: el acceso real lo
# controla Row Level Security (ver assets/sql/rls-policies.sql), no el
# secreto de la key.
#
# NUNCA seas pongas la service_role key en ningún archivo de este
# repositorio (ni aquí, ni en config.js): esa key salta todas las
# políticas RLS y solo debe usarse desde un backend privado, que este
# proyecto no tiene.
# =====================================================================

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU-ANON-KEY-AQUI
